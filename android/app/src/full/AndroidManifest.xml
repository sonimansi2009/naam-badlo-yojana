<?xml version="1.0" encoding="utf-8"?>
<!-- Full edition only: the floating button. Lite leaves this out so Play Protect does not block it. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Floating "Make it Meta-proof" button over other apps -->
        <service
            android:name=".FloatingButtonService"
            android:exported="true"
            android:label="@string/a11y_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/floating_button" />
        </service>
    </application>
</manifest>
